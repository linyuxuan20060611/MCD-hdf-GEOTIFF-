from pyhdf.SD import SD, SDC


HDF_PATH = Path(
    r"C:\Users\linyu\Desktop\科研\MCD12C1 MODIS土地利用类型数据"
    r"\MCD12C1_061-2010年\MCD12C1.A2010001.061.2022161022952.hdf"
)
GLC_EXTENT = Path(
    r"C:\Users\linyu\Desktop\科研\GLC_FCS30D数据\E110-E115"
    r"\2010年处理结果\GLC_2010_E110_E115_mosaic.tif"
